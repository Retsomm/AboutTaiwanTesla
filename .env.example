# All values below are server-side / GitHub Actions secrets or variables.
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
# TDX official OpenAPI v1. Scope is Taichung, not all Taiwan.
TDX_STATIONS_URL=https://tdx.transportdata.tw/api/basic/v1/EV/Station/City/Taichung?$format=JSON
# Optional official CSV URL; otherwise discover from dataset 30202.
THB_MARKET_CSV_URL=
# Required official monthly passenger-car brand CSV: 統計期,廠牌,小客車
THB_BRAND_CSV_URL=
# Official RSS URL from THB's RSS subscription page.
THB_NEWS_RSS_URL=
